<?xml version="1.0"?>
<sdf version="1.6">
  <model name="warehouse_lidar_blocker_short">
    <static>true</static>
    <link name="link">
      <!-- Keep the shelf footprint lidar-visible, but put the distinguishing
           features on the OUTSIDE of the rack so they are actually visible to
