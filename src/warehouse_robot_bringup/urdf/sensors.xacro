<?xml version="1.0"?>
<!-- Sensors for Gazebo Harmonic (gz-sim): LiDAR + RGB Camera
     These use native Gazebo Sim sensor types and publish on gz-transport.
     Topics are bridged to ROS2 via ros_gz_bridge in the launch file. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ==================== LiDAR SENSOR ==================== -->

    <link name="laser_frame_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${laser_frame_radius}" length="${laser_frame_length}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${laser_frame_radius}" length="${laser_frame_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${laser_frame_mass}" length="${laser_frame_length}" radius="${laser_frame_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name="laser_frame_joint" type="fixed">
        <parent link="chassis_bottom_link"/>
        <child link="laser_frame_link"/>
        <origin xyz="0 0 ${chassis_bottom_height + chassis_top_height + (laser_frame_length / 2)}" rpy="0 0 0" />
    </joint>

    <!-- Gazebo Harmonic gpu_lidar sensor (publishes on gz-transport, bridged to /scan) -->
    <gazebo reference="laser_frame_link">
        <sensor name="lidar" type="lidar">
            <pose>0 0 0 0 0 0</pose>
            <topic>/scan</topic>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <gz_frame_id>laser_frame_link</gz_frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>


    <!-- ==================== RGB CAMERA SENSOR ==================== -->

    <link name="camera_link">
        <visual>
            <origin xyz="${camera_size_x / 2} ${camera_size_y / 2} ${camera_size_z / 2}" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="fork_base_link"/>
        <child link="camera_link"/>
        <origin xyz="${(fork_base_length / 2) + 0.05} 0 ${fork_base_height + 0.02}" rpy="0 0.5 0"/>
    </joint>
    

    <!-- Optical frame (standard ROS camera convention: Z-forward, X-right, Y-down) -->
    <link name="camera_link_optical"></link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>

    <!-- Gazebo Harmonic camera sensor (publishes on gz-transport, bridged to /camera/image_raw) -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <topic>camera</topic>
            <update_rate>15</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <gz_frame_id>camera_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>${camera_image_width}</width>
                    <height>${camera_image_height}</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>${camera_image_clip_near}</near>
                    <far>${camera_image_clip_far}</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>
