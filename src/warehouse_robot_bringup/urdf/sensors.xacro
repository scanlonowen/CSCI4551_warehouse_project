<?xml version="1.0"?>
<!-- Sensors for Gazebo Harmonic (gz-sim): multi-LiDAR ring + RGB camera.
     The four 2D lidars are mounted at the same height and face outward:
       - front
       - left
       - right
       - rear
     They publish separate gz topics and are merged in ROS into a single
     virtual 360 scan for RViz / Nav2 / AMCL. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ==================== LiDAR SENSORS ==================== -->

    <xacro:property name="lidar_mount_height" value="0.15" />
    <xacro:property name="front_lidar_x" value="1.30" />
    <xacro:property name="side_lidar_x" value="0.15" />
    <xacro:property name="side_lidar_y" value="${(chassis_bottom_width / 2) + 0.12}" />
    <xacro:property name="rear_lidar_x" value="${-((chassis_bottom_length / 2) + 0.10)}" />
    <xacro:property name="lidar_fov_half_angle" value="1.0472" />
    <xacro:property name="lidar_samples" value="121" />

    <xacro:macro
        name="planar_lidar_sensor"
        params="link_name joint_name parent x y z yaw topic sensor_name">
        <link name="${link_name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="${laser_frame_radius}" length="${laser_frame_length}"/>
                </geometry>
                <material name="white">
                    <color rgba="1 1 1 1"/>
                </material>
            </visual>
            <xacro:inertial_cylinder
                mass="${laser_frame_mass}"
                length="${laser_frame_length}"
                radius="${laser_frame_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <joint name="${joint_name}" type="fixed">
            <parent link="${parent}"/>
            <child link="${link_name}"/>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 ${yaw}" />
        </joint>

        <gazebo reference="${link_name}">
            <sensor name="${sensor_name}" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <topic>${topic}</topic>
                <update_rate>10</update_rate>
                <always_on>true</always_on>
                <visualize>true</visualize>
                <gz_frame_id>${link_name}</gz_frame_id>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${lidar_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>-${lidar_fov_half_angle}</min_angle>
                            <max_angle>${lidar_fov_half_angle}</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.08</min>
                        <max>24.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:macro>

    <!-- Front lidar stays at the successful low-forward mount between the forks. -->
    <xacro:planar_lidar_sensor
        link_name="laser_frame_link"
        joint_name="laser_frame_joint"
        parent="chassis_bottom_link"
        x="${front_lidar_x}"
        y="0"
        z="${lidar_mount_height}"
        yaw="0"
        topic="lidar_front"
        sensor_name="gpu_lidar_front"/>

    <!-- Side lidars are mounted just outside the chassis and point laterally. -->
    <xacro:planar_lidar_sensor
        link_name="laser_left_link"
        joint_name="laser_left_joint"
        parent="chassis_bottom_link"
        x="${side_lidar_x}"
        y="${side_lidar_y}"
        z="${lidar_mount_height}"
        yaw="${pi / 2}"
        topic="lidar_left"
        sensor_name="gpu_lidar_left"/>

    <xacro:planar_lidar_sensor
        link_name="laser_right_link"
        joint_name="laser_right_joint"
        parent="chassis_bottom_link"
        x="${side_lidar_x}"
        y="-${side_lidar_y}"
        z="${lidar_mount_height}"
        yaw="${-pi / 2}"
        topic="lidar_right"
        sensor_name="gpu_lidar_right"/>

    <!-- Rear lidar covers backing and aisle exit alignment. -->
    <xacro:planar_lidar_sensor
        link_name="laser_rear_link"
        joint_name="laser_rear_joint"
        parent="chassis_bottom_link"
        x="${rear_lidar_x}"
        y="0"
        z="${lidar_mount_height}"
        yaw="${pi}"
        topic="lidar_rear"
        sensor_name="gpu_lidar_rear"/>


    <!-- ==================== RGB CAMERA SENSOR ==================== -->

    <link name="camera_link">
        <visual>
            <origin xyz="${camera_size_x / 2} ${camera_size_y / 2} ${camera_size_z / 2}" rpy="0 0 0"/>
            <geometry>
                <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="fork_base_link"/>
        <child link="camera_link"/>
        <origin xyz="${fork_base_length / 2} 0 ${fork_base_height + 0.02}" rpy="0 0 0"/>
    </joint>

    <!-- Optical frame (standard ROS camera convention: Z-forward, X-right, Y-down) -->
    <link name="camera_link_optical"></link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>

    <!-- Gazebo Harmonic camera sensor (publishes on gz-transport, bridged to /camera/image_raw) -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <topic>camera</topic>
            <update_rate>15</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <gz_frame_id>camera_link_optical</gz_frame_id>
            <camera>
                <horizontal_fov>1.089</horizontal_fov>
                <image>
                    <width>${camera_image_width}</width>
                    <height>${camera_image_height}</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>${camera_image_clip_near}</near>
                    <far>${camera_image_clip_far}</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>
